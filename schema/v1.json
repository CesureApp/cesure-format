{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CesureApp/cesure-format/schema/v1.json",
  "title": "Cesure File v1",
  "description": "Schema for .cesure tablature files, version 1.",
  "type": "object",
  "required": [
    "version",
    "score"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Format version. Must be 1 for this schema."
    },
    "score": {
      "$ref": "#/$defs/Score"
    }
  },
  "$defs": {
    "Score": {
      "type": "object",
      "description": "The root musical score.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "default": "Untitled"
        },
        "artist": {
          "type": "string",
          "default": ""
        },
        "album": {
          "type": "string",
          "default": ""
        },
        "tempo": {
          "type": "integer",
          "minimum": 1,
          "default": 120,
          "description": "Initial tempo in BPM."
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          },
          "default": []
        },
        "tempoChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TempoChange"
          },
          "default": [],
          "description": "Mid-song tempo changes. Empty = constant tempo."
        }
      }
    },
    "TempoChange": {
      "type": "object",
      "description": "A tempo change taking effect at the start of a measure, until the next one.",
      "additionalProperties": false,
      "required": [
        "measureIndex",
        "tempo"
      ],
      "properties": {
        "measureIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "0-indexed measure the new tempo starts at."
        },
        "tempo": {
          "type": "integer",
          "minimum": 1,
          "description": "Tempo in BPM from that measure on."
        }
      }
    },
    "Track": {
      "type": "object",
      "description": "A single instrument track.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "default": "Guitar"
        },
        "tuning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AbsNote"
          },
          "description": "String tuning from string 1 (highest) to string N (lowest).",
          "default": [
            {
              "note": "E",
              "octave": 4
            },
            {
              "note": "B",
              "octave": 3
            },
            {
              "note": "G",
              "octave": 3
            },
            {
              "note": "D",
              "octave": 3
            },
            {
              "note": "A",
              "octave": 2
            },
            {
              "note": "E",
              "octave": 2
            }
          ]
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measure"
          },
          "default": []
        },
        "capo": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Capo position in frets (0 = none). Tab numbers stay relative to the capo; only the sounding pitch shifts up."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Track volume in the mix, 0..1. An arrangement property like `capo`: imported from Guitar Pro, saved and exported. Absent means 1 (full scale)."
        },
        "instrument": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "GUITAR",
            "BASS",
            "PIANO",
            null
          ],
          "default": null,
          "description": "Timbre of the track, or null/absent = unspecified. Deliberately narrow: it lists only what a player can actually render. Absent is NOT \"guitar\" — it means the file says nothing, and a player should fall back to its own sound preference."
        }
      }
    },
    "Measure": {
      "type": "object",
      "description": "A single bar.",
      "additionalProperties": false,
      "properties": {
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "default": []
        },
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "denominator": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ],
          "default": 4
        }
      }
    },
    "Beat": {
      "type": "object",
      "description": "A rhythmic position in a measure. Empty notes = rest.",
      "required": [
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "duration": {
          "$ref": "#/$defs/Duration"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TabNote"
          },
          "default": []
        },
        "isDotted": {
          "type": "boolean",
          "default": false,
          "description": "If true, duration × 1.5."
        }
      }
    },
    "TabNote": {
      "type": "object",
      "description": "A single note at a (string, fret) position.",
      "required": [
        "string",
        "fret"
      ],
      "additionalProperties": false,
      "properties": {
        "string": {
          "type": "integer",
          "minimum": 1,
          "description": "1-indexed string (1 = highest/thinnest)."
        },
        "fret": {
          "type": "integer",
          "minimum": -1,
          "description": "Fret number. 0 = open. -1 = muted."
        },
        "techniques": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TabTechnique"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Playing techniques attached to the note."
        },
        "bendSemitones": {
          "type": "integer",
          "default": 2,
          "description": "Bend amplitude in semitones; meaningful only when techniques include BEND."
        },
        "voice": {
          "$ref": "#/$defs/TabVoice",
          "description": "Explicitly assigned voice. Absent or null = automatic (derived from register)."
        }
      }
    },
    "TabVoice": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "A",
        "B",
        null
      ],
      "description": "Voice of a note. A = lower voice, B = upper voice. null = automatic."
    },
    "TabTechnique": {
      "type": "string",
      "enum": [
        "HAMMER_PULL",
        "SLIDE",
        "BEND",
        "VIBRATO",
        "TAPPING"
      ],
      "description": "Playing technique. HAMMER_PULL and SLIDE are transitions toward the next note on the same string."
    },
    "Duration": {
      "type": "string",
      "enum": [
        "WHOLE",
        "HALF",
        "QUARTER",
        "EIGHTH",
        "SIXTEENTH",
        "THIRTY_SECOND"
      ],
      "description": "Musical note value. Quarter-note counts: WHOLE=4, HALF=2, QUARTER=1, EIGHTH=0.5, SIXTEENTH=0.25, THIRTY_SECOND=0.125."
    },
    "AbsNote": {
      "type": "object",
      "description": "An absolute pitch (pitch class + octave).",
      "required": [
        "note",
        "octave"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "enum": [
            "C",
            "Cs",
            "D",
            "Ds",
            "E",
            "F",
            "Fs",
            "G",
            "Gs",
            "A",
            "As",
            "B"
          ],
          "description": "Pitch class. 's' suffix = sharp (e.g. Cs = C#)."
        },
        "octave": {
          "type": "integer",
          "description": "Octave number in scientific pitch notation. Middle C = {note: C, octave: 4}."
        }
      }
    }
  }
}
